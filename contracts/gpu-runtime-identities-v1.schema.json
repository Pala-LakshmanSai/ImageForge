{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imageforge.local/contracts/gpu-runtime-identities-v1.schema.json",
  "title": "GPU runtime identities v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "identities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providerGpuId", "cudaNames", "pciDeviceIds", "minimumMemoryBytes", "minimumComputeCapability"],
        "properties": {
          "providerGpuId": { "$ref": "gpu-identity-v1.schema.json" },
          "cudaNames": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "$ref": "gpu-identity-v1.schema.json" }
          },
          "pciDeviceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^0x[0-9a-f]{4}$" }
          },
          "minimumMemoryBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "minimumComputeCapability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["major", "minor"],
            "properties": {
              "major": { "type": "integer", "minimum": 1, "maximum": 99 },
              "minor": { "type": "integer", "minimum": 0, "maximum": 99 }
            }
          }
        }
      }
    }
  }
}
