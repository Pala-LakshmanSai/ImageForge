{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imageforge.local/contracts/runpod-price-v1.schema.json",
  "title": "ImageForge RunPod raw price vectors v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "surface", "rawJson", "expectedValid", "expectedMicroUsd", "expectedSource"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
          "surface": { "enum": ["inventory", "pod"] },
          "rawJson": { "type": "string", "minLength": 1 },
          "expectedValid": { "type": "boolean" },
          "expectedMicroUsd": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
          "expectedSource": { "enum": ["adjusted", "cost", "unavailable", "invalid"] }
        }
      }
    }
  }
}
